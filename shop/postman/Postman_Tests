      "name": "Create Order Success",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.sendRequest({\r\n    url: 'http://localhost:8080/api/tests/setup',\r\n    method: 'POST'\r\n}, function (err, res) {\r\n    if (err) {\r\n        console.log(err);\r\n    } else {\r\n        var jsonData = res.json();\r\n        \r\n        pm.variables.set(\"testUserId\", jsonData.userId);\r\n        pm.variables.set(\"testProductId\", jsonData.productId);\r\n        \r\n        console.log(\"Database seeded successfully!\");\r\n    }\r\n});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\npm.sendRequest({\r\n    url: 'http://localhost:8080/api/test-data/teardown',\r\n    method: 'POST'\r\n}, function (err, res) {\r\n    if (err) {\r\n        console.log(\"Teardown failed: \", err);\r\n    } else {\r\n        console.log(\"Database cleared successfully!\");\r\n    }\r\n});"
            ]
          }
        }
      ],
